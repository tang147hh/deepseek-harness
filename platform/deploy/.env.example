# Copy to platform/deploy/.env  (never commit .env)

# Hosts — keep the app host off the pages parent so cookies stay isolated.
# Cookie Domain must be APP_HOST itself (never the registrable parent).
# Local:
APP_HOST=app.localhost
PAGES_HOST=pages.localhost
PAGES_PARENT=pages.localhost
# Generic server example:
# APP_HOST=app.example.com
# PAGES_HOST=pages.example.com
# PAGES_PARENT=pages.example.com
# 1Panel production (locked hostnames; Cookie Domain = www.996-code.com only):
# APP_HOST=www.996-code.com
# PAGES_HOST=pages.996-code.com
# PAGES_PARENT=pages.996-code.com

# TLS: internal = Caddy local CA (dev). dns = Let's Encrypt DNS-01 (server).
TLS_MODE=internal
ACME_EMAIL=admin@localhost
CADDY_IMAGE=caddy:2.10-alpine
# Server DNS-01 (after `docker build -t dsh-caddy:dns -f Dockerfile.caddy .`):
# TLS_MODE=dns
# CADDY_IMAGE=dsh-caddy:dns
# ACME_EMAIL=admin@example.com
# DNS_API_TOKEN=

POSTGRES_USER=dsh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dsh

# Session cookie pepper (sha256). Replace the placeholder; do not commit a real value.
SESSION_SECRET=change-me-to-a-long-random-string
# SESSION_TTL_SECONDS=604800

# HMAC secret for short-lived PLATFORM_USER_TOKEN (Agent → POST /sites/publish).
# Distinct from SESSION_SECRET and from site KV write tokens. Replace the placeholder.
PLATFORM_TOKEN_SECRET=change-me-platform-token-secret
# PLATFORM_TOKEN_TTL_SECONDS=43200

# Optional. If the users table is empty, this invite is inserted (one-time).
# If unset, control-plane generates a code and prints it to its logs.
# BOOTSTRAP_INVITE_CODE=

# Compose volume mounts (relative to this file is OK):
# Layout: users/{id}/home, users/{id}/workspace, snapshots, postgres, caddy
DATA_ROOT=./data

# Absolute path on the Docker HOST for user-container bind mounts.
# runtime-manager passes this to the Engine as the bind *source*.
# A relative ./data path is resolved inside the manager container and will NOT work.
# HOST_DATA_ROOT must point at the same directory as DATA_ROOT on the host.
#   Linux server:   DATA_ROOT=/data
#                   HOST_DATA_ROOT=/data
#   Linux checkout: HOST_DATA_ROOT=/home/you/Deepseek_Harness/platform/deploy/data
#   Windows:        HOST_DATA_ROOT=C:/Deepseek_Harness/platform/deploy/data
HOST_DATA_ROOT=/data

# Shared token: control-plane → runtime-manager (internal only; do not publish
# runtime-manager ports). Placeholder only — do not commit a real value.
RUNTIME_MANAGER_TOKEN=change-me-runtime-manager-token

# Idle stop (do not rm) when the user container has no TCP clients on 3080.
IDLE_SECONDS=900
# Max concurrent running user runtimes. 4C/8G production: keep at 2.
MAX_RUNTIMES=2
# Per-user container limits (Docker Memory / NanoCpus).
RUNTIME_MEMORY=1g
RUNTIME_CPUS=1.0
# dsh web cold start can exceed 30s; wait this long for TCP 3080.
RUNTIME_READY_TIMEOUT_MS=120000

# Workspace file API (control-plane /files). Per-file and per-user workspace caps.
# FILE_MAX_BYTES=20971520
# FILE_QUOTA_BYTES=524288000
# Published site snapshot cap (whole site, default 20MB).
# SITE_MAX_BYTES=20971520
# Public site KV on the pages host (not APP_HOST). Per-key 64KB, per-site 1MB.
# KV_VALUE_MAX_BYTES=65536
# KV_SITE_MAX_BYTES=1048576
# KV_WRITE_PER_MINUTE=30

# Do not set DEEPSEEK_API_KEY here or anywhere in Compose / global env.
# Each user will store their own key under that user's DSH_HOME.
